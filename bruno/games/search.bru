meta {
  name: Search games
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/games/search?q={{q}}
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body) && res.body.length > 0) {
    bru.setVar("rawgId", String(res.body[0].rawgId));
  }
}

tests {
  test("search returns 200", function() {
    expect(res.status).to.equal(200);
  });
}
