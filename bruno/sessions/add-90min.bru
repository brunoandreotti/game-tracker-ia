meta {
  name: Add session 90 min
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tracked-games/{{trackedGameId}}/sessions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "durationMinutes": 90,
    "playedAt": "2026-08-27"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id != null) {
    bru.setVar("sessionId", String(res.body.id));
  }
}

tests {
  test("add session returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
