meta {
  name: Add tracked game
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/tracked-games
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "rawgId": {{rawgId}},
    "status": "PLAYING"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id != null) {
    bru.setVar("trackedGameId", String(res.body.id));
  }
}

tests {
  test("add returns 201", function() {
    expect(res.status).to.equal(201);
  });
}
